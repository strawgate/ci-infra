[Unit]
Description=Prune old Docker build cache and unused images
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=2h
ExecStart=/usr/bin/docker buildx prune --force --max-used-space 150GB
ExecStart=/usr/bin/docker image prune --all --force --filter until=168h
